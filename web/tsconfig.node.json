{
  // P2 加固：把 vite.config.ts 纳入 tsc 覆盖。
  // 历史事故：vite.config.ts 内 `Record<string, string | undefined>` 泛型漏写闭合 `>`
  // 时，tsc 因 tsconfig.json 的 include 仅含 `src` 而全程静默，
  // 错误直到 vite build 的 esbuild 加载阶段才暴露，直接导致 dist 不产出。
  // 本文件作为被 references 引用的独立 project，只负责编译期校验 Node 侧配置脚本。
  "compilerOptions": {
    "composite": true,
    // composite 项目不允许 noEmit（TS6310），故改为仅产声明文件并输出到 node_modules/.tmp，
    // 既不污染源码目录，又能让 `tsc -b` 一条命令把 vite.config.ts 一并纳入门禁。
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/node-types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "strict": true,
    // P4 加固：web 根目录下的 postcss.config.js / tailwind.config.js 均为 ESM JS 配置，
    // 需 allowJs 才能被本 project 纳入语法/类型检查（否则它们仍然完全游离在 tsc 之外）。
    // 注意：allowJs 与 composite/emitDeclarationOnly 可共存，仅生成 .d.ts 到 node_modules/.tmp。
    "allowJs": true,
    // checkJs=true：让 JS 配置也走语义检查（不是只解析语法）。
    // 代价仅为 tailwind.config.js 内少量 JSDoc 标注，不改变任何运行时行为。
    "checkJs": true
  },
  // ⚠️ 显式列举文件名，严禁 `**/*` 宽泛通配（会把 src 与 public 一并卷入本 project，
  // 与主 project 的 include: ["src"] 重复归属，触发 TS6307/TS6059 类问题）。
  "include": ["vite.config.ts", "postcss.config.js", "tailwind.config.js"]
}
