# ============================================================
# Harness_go .gitignore
# 仅纳入源码、配置、文档与知识库；以下均为可再生的构建产物、
# 依赖、运行时数据与调试快照
# ============================================================

# ---------- 依赖与构建产物 ----------
node_modules/
# 前端构建产物：demo 为只读视觉基线，其 dist 不入库；
# web/dist 需要「目录存在」（//go:embed all:dist 的编译期要求），故只忽略内容、保留 .gitkeep
/demo/dist/
/web/dist/*
!/web/dist/.gitkeep
build/
out/
*.tsbuildinfo
.vite/
coverage/

# Go 构建产物（后续单二进制服务端）
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.prof
/harness-go
/harness_go
/data/
/bin/
*.db
*.db-wal
*.db-shm
.golangci-lint-cache/

# ---------- 日志与临时文件 ----------
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.cache
.DS_Store
Thumbs.db
desktop.ini

# ---------- 编辑器与 IDE ----------
.idea/
.vscode/
*.iml
*.swp
.sublime-workspace

# ---------- 环境变量与密钥 ----------
.env
.env.*
!.env.example
# web/.env.real 仅含 VITE_API_MODE=real（无任何密钥），必须随仓分发，
# 否则 `npm run dev:real` 会因缺少 mode 文件静默回落到 mock，开发态误判"接线没通"。
!web/.env.real
*.pem
secret.key

# ---------- Harness Agent 运行时数据 ----------
# ⚠️ 必须写成 .harness/* 而不是 .harness/ —— Git 有个经典陷阱：父目录被整体忽略时，
# 子目录的 ! 否定规则**完全失效**。写成 .harness/ 会导致下面的 !.harness/sop/ 形同虚设。
# 需求背景：项目级 SOP / skill 需要能随项目提交给团队；没 add 的就等价于本机私有。
.harness/*
!.harness/sop/
!.harness/skills/
*.pid

# ---------- demo 调试快照与浏览器录制宏 ----------
# ARIA 页面快照 / 自动化录制提示词（工具生成，可重新录制）
demo/*.yaml
# Playwright 自动化调试产物（页面快照、trace、报告）
demo/.playwright-cli/
demo/.playwright/
demo/playwright-report/
demo/test-results/
# 验收截图（自测产物）
demo/*.png
demo/serve.out.log
demo/serve.err.log

# ---------- 本机验证/调试遗留（严禁入库） ----------
# data_verify：本地联调用的临时数据目录（含 initial_password / secret.key / db）
/data_verify/
# 根目录自测截图与误重定向产生的临时文件
/check*.png
/query
/status.txt

# ---------- 其他 ----------
*.zip
*.tar
*.tar.gz
dist
