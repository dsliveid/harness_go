# ============================================================
# 换行符规范化（根治 Windows 下 gofmt 全量误报）
# ============================================================
# 背景：本仓库在 Windows 上以 core.autocrlf=true 检出，工作区所有文件被转成 CRLF；
# 而 gofmt（以及 Go 生态的绝大多数工具）要求 LF。
# 后果：`gofmt -l .` 会把全部 Go 文件报成"格式不规范"（实测 90/90 全部命中），
#       但文件内容其实没有任何格式问题——开发者一旦执行 `gofmt -w .`，
#       就会把 90 个文件的换行全部改掉，产生巨量与业务无关的伪 diff。
#
# 这里显式声明仓库内的文本文件一律以 LF 存储与检出，与 Linux/macOS/CI 保持一致，
# 且优先级高于 core.autocrlf（.gitattributes 的 eol 设置会覆盖 autocrlf）。
#
# 注意：若工作区已有 CRLF 文件，本文件生效后需重新检出才会转回 LF：
#   git rm -r --cached . && git reset --hard HEAD
# ============================================================

# 源码与配置：统一 LF
*.go        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sql       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.mod       text eol=lf
*.sum       text eol=lf
Makefile    text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# 脚本：Linux/macOS 需 LF；Windows PowerShell 脚本通常也能接受 LF（PS 5.1+ 支持）
*.sh        text eol=lf
*.ps1       text eol=crlf

# 二进制：禁止任何换行转换与文本 diff
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.zip       binary
*.exe       binary
*.pdf       binary
*.db        binary
*.db-wal    binary
*.db-shm    binary
